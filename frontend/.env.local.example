# ─────────────────────────────────────────────────────────────────────────────
# Frontend Reisolari — variáveis públicas (NEXT_PUBLIC_*)
# Copie para "frontend/.env.local" (dev) ou passe como build-args no Docker.
# ATENÇÃO: estas variáveis são embebidas no bundle em BUILD-TIME.
# (A config do Firebase é pública e está embutida em lib/firebase.ts.)
# ─────────────────────────────────────────────────────────────────────────────

# URL pública do backend. Sem barra final.
#  - Domínios separados:        https://api.exemplo.pt
#  - Mesmo domínio (proxy /api): deixe vazio  ("")
NEXT_PUBLIC_BACKEND_URL=https://api.exemplo.pt

# Token público do Mapbox (mesmo do backend MAPBOX_TOKEN).
NEXT_PUBLIC_MAPBOX_TOKEN=
