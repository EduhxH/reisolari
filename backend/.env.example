# ─────────────────────────────────────────────────────────────────────────────
# Backend Reisolari — variáveis de ambiente
# Copie para "backend/.env" (ou "backend/env") e preencha os valores reais.
# NUNCA faça commit do ficheiro preenchido (está no .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# "development" ou "production". Em produção, o CORS só aceita as origens abaixo.
ENVIRONMENT=production

# URLs públicas (sem barra final). Usadas em links (PDF, sourcing) e no CORS.
FRONTEND_PUBLIC_URL=https://app.exemplo.pt
BACKEND_PUBLIC_URL=https://api.exemplo.pt
# Origens extra permitidas pelo CORS, separadas por vírgula (opcional).
CORS_ORIGINS=

# ── Base de dados / cache ────────────────────────────────────────────────────
# Em docker-compose: mongodb://mongodb:27017 e redis://redis:6379/0
# Com MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
MONGO_URI=mongodb://mongodb:27017
REDIS_URL=redis://redis:6379/0

# ── Segurança ────────────────────────────────────────────────────────────────
# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=troque-isto-por-um-segredo-forte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Firebase (apenas o project id público; a verificação usa as chaves da Google) ─
FIREBASE_PROJECT_ID=reisolari-92630
# uids de Firebase com acesso à área de moderação, separados por vírgula.
ADMIN_UIDS=

# ── Integrações externas ─────────────────────────────────────────────────────
# Mapbox (mapa do telhado). https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=
# Groq (extração da fatura por visão + prosa dos agentes). https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
# SerpAPI (Google Shopping → painéis reais no menu "Ideais" e fotos do catálogo).
SERPAPI_API_KEY=
# Stripe (checkout da loja). https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
