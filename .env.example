# Variáveis lidas pelo docker-compose.prod.yml (build-args do frontend).
# Copie para ".env" na raiz e preencha. Os segredos do backend ficam em backend/.env.

# URL pública do backend (sem barra final). Domínios separados → https://api.exemplo.pt
# Mesmo domínio com proxy /api → deixe vazio.
NEXT_PUBLIC_BACKEND_URL=https://api.exemplo.pt

# Token público do Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=
